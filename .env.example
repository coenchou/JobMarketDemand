# Copy to .env and fill in. Never commit the real .env.

# Optional. Enables LLM resume extraction and refined recommendations.
# Without it the app still runs on the regex parser and dataset recommendations.
GROQ_API_KEY=

# Comma-separated origins allowed to call the API from another host.
# Leave empty when the API serves the frontend itself (the default).
ALLOWED_ORIGINS=

# Set to 1 to cache LLM responses on disk. Off by default on the server:
# cached responses contain resume-derived content.
LLM_CACHE=0

# Chat model used for resume extraction and recommendation refinement.
LLM_MODEL=openai/gpt-oss-120b

PORT=8000
